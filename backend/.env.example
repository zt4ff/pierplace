# Copy to .env (never commit real secrets). Local dev values:
# TCP (Postgres with a password):
PIERPLACE_DATABASE_URL=postgresql+asyncpg://pierplace:pierplace@localhost:5432/pierplace
# Bare-metal unix socket with peer auth (Debian/Ubuntu, no password):
# PIERPLACE_DATABASE_URL=postgresql+asyncpg://<os-user>@/pierplace?host=/var/run/postgresql
PIERPLACE_JWT_SECRET=dev-secret
# Optional: host/port/reload for `python -m app`
# PIERPLACE_HOST=0.0.0.0
# PIERPLACE_PORT=8000
# PIERPLACE_RELOAD=1
